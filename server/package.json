{
  "name": "@ryurim/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file=../.env --import tsx --watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=../.env dist/server/src/main.js",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --env-file=../.env --import tsx src/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0"
  }
}
